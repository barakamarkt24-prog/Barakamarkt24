{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "postalCode": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "nameDe": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "isActive": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "itemCount": { "type": "number" },
        "featured": { "type": "boolean" }
      },
      "required": ["id", "nameAr"]
    },
    "Subcategory": {
      "title": "Subcategory",
      "description": "Product subcategory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subcategoryId": { "type": "string" },
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "image": { "type": "string" },
        "isActive": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "categoryId", "nameAr"]
    },
    "Product": {
      "title": "Product",
      "description": "Syrian pantry and grocery item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "nameDe": { "type": "string" },
        "description": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "price": { "type": "number" },
        "oldPrice": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discount": { "type": "number" },
        "categoryId": { "type": "string" },
        "subcategoryId": { "type": "string" },
        "subCategory": { "type": "string" },
        "images": { "type": "array" },
        "image": { "type": "string" },
        "stock": { "type": "number" },
        "stockCount": { "type": "number" },
        "unit": { "type": "string" },
        "weight": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "inStock": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "isBestseller": { "type": "boolean" },
        "isHalal": { "type": "boolean" },
        "isOrganic": { "type": "boolean" },
        "isColdShipping": { "type": "boolean" },
        "origin": { "type": "string" },
        "brand": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "badge": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "ingredientsAr": { "type": "string" },
        "storageAr": { "type": "string" }
      },
      "required": ["id", "nameAr", "categoryId", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "timestamp": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "total", "status"]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Individual item inside an order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "productId": { "type": "string" },
        "productNameAr": { "type": "string" },
        "price": { "type": "number" },
        "quantity": { "type": "number" },
        "image": { "type": "string" },
        "total": { "type": "number" }
      },
      "required": ["id", "orderId", "productId", "price", "quantity"]
    },
    "Address": {
      "title": "Address",
      "description": "Saved shipping address",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "titleAr": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "street": { "type": "string" },
        "postalCode": { "type": "string" },
        "isDefault": { "type": "boolean" }
      },
      "required": ["id", "userId", "city", "street"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "User favorite product bookmark",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "productId"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount voucher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "discountPercent": { "type": "number" },
        "discountAmount": { "type": "number" },
        "minSpend": { "type": "number" },
        "validUntil": { "type": "string" },
        "isActive": { "type": "boolean" },
        "descriptionAr": { "type": "string" }
      },
      "required": ["id", "code", "isActive"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Promotional banner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titleAr": { "type": "string" },
        "subtitleAr": { "type": "string" },
        "image": { "type": "string" },
        "discountTag": { "type": "string" },
        "active": { "type": "boolean" },
        "linkCategoryId": { "type": "string" },
        "linkProductId": { "type": "string" }
      },
      "required": ["id", "titleAr", "active"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User push/in-app notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message"]
    },
    "Referral": {
      "title": "Referral",
      "description": "Referral invite and rewards",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referrerUserId": { "type": "string" },
        "referredUserId": { "type": "string" },
        "code": { "type": "string" },
        "bonusApplied": { "type": "boolean" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "referrerUserId", "code"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles with role-based access"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Public store categories"
    },
    "/subcategories/{subcategoryId}": {
      "schema": "Subcategory",
      "description": "Public store subcategories"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public store product catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "/orderItems/{itemId}": {
      "schema": "OrderItem",
      "description": "Items associated with orders"
    },
    "/addresses/{addressId}": {
      "schema": "Address",
      "description": "User shipping addresses"
    },
    "/favorites/{favId}": {
      "schema": "Favorite",
      "description": "User wishlist bookmarks"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Store discount coupons"
    },
    "/offers/{offerId}": {
      "schema": "Offer",
      "description": "Store special promotional banners"
    },
    "/notifications/{notifId}": {
      "schema": "Notification",
      "description": "In-app notifications"
    },
    "/referrals/{refId}": {
      "schema": "Referral",
      "description": "User referral program records"
    }
  }
}
