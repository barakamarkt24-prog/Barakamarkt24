rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@barakamarkt24.com' ||
        request.auth.token.email == 'admin@barakamarkt24.de' ||
        request.auth.token.email == 'erttqw71@gmail.com' ||
        request.auth.token.email == 'barakamarkt24@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isDriver() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver'
      );
    }

    // Default deny for unspecified routes
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection (Profile protection against privilege escalation)
    // - Admin can read/write all
    // - Customer can read/update their own profile (cannot escalate role or isAdmin)
    // - Driver can read/update their own profile only
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId && 
        (request.resource.data.role == 'customer' || !('role' in request.resource.data) || isAdmin());
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'driverId', 'email', 'id'])
      );
      allow delete: if isAdmin();
    }

    // Categories Collection (Public read, Admin write)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Subcategories Collection (Public read, Admin write)
    match /subcategories/{subcategoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products Collection (Public read, Admin write only - users cannot modify, change price or delete)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    // - Read: Customer sees only their own, Driver sees assigned, Admin sees all
    // - Create: Authenticated customer can create with status in ['received', 'pending'], no pre-assigned driver
    // - Update: Admin can update fully. Customer can ONLY cancel if status is received/pending. Driver can only update delivery status.
    // - Delete: Admin only
    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.driverId == request.auth.uid));
      
      allow create: if isAdmin() || (
        ((isAuthenticated() && request.resource.data.userId == request.auth.uid) || request.resource.data.userId == 'guest') &&
        (request.resource.data.status in ['received', 'pending']) &&
        (!('driverId' in request.resource.data) || request.resource.data.driverId == '')
      );
      
      allow update: if isAdmin() || (
        // Customer can cancel their own order before preparation starts
        isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'notes', 'timeline']) &&
        resource.data.status in ['received', 'pending'] &&
        request.resource.data.status == 'cancelled'
      ) || (
        // Customer can submit or update notes/issues on their own orders without altering financial or order data
        isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerNote', 'customerNoteCategory', 'customerNoteCreatedAt', 'customerNoteUpdatedAt', 'customerNoteStatus', 'updatedAt']) &&
        request.resource.data.customerNoteStatus in ['open', 'none']
      ) || (
        // Driver can only advance delivery status for their assigned orders
        isDriver() &&
        resource.data.driverId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'deliveredAt', 'deliveryNotes', 'timeline']) &&
        request.resource.data.status in ['on_the_way', 'delivered', 'delivery_failed']
      );
      
      allow delete: if isAdmin();
    }

    // OrderItems Collection
    // - Read: Admin can read all. Customers can read items belonging to their own order. Drivers can read items for assigned orders.
    // - Create: Validated item creation tied to an authentic order in the same transaction/batch (both authenticated and guest orders).
    // - Update/Delete: Admin only (no modification allowed by customer or driver after creation)
    match /orderItems/{itemId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          (resource.data.userId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/orders/$(resource.data.orderId)) && 
           (get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.userId == request.auth.uid ||
            get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.driverId == request.auth.uid))
        )
      );
      
      allow create: if isAdmin() || (
        request.resource.data.orderId is string &&
        request.resource.data.productId is string &&
        request.resource.data.price is number &&
        request.resource.data.quantity is number &&
        request.resource.data.price >= 0 &&
        request.resource.data.quantity > 0 &&
        existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
        getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status in ['received', 'pending'] &&
        (
          (isAuthenticated() && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid) ||
          (!isAuthenticated() && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == 'guest') ||
          (getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == 'guest')
        )
      );
      
      allow update, delete: if isAdmin();
    }

    // Addresses Collection
    match /addresses/{addressId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Favorites Collection
    match /favorites/{favId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Coupons Collection (Public read, Admin write)
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Offers Collection (Public read, Admin write)
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || (isDriver() && resource.data.userId == 'driver')));
      allow create: if isAdmin() || (isAuthenticated() && (request.resource.data.type in ['order', 'promo', 'system'] || request.resource.data.userId == 'admin' || request.resource.data.userId == request.auth.uid));
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // FCM Device Push Tokens Collection
    match /fcmTokens/{tokenId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin() || (
        (isAuthenticated() && request.resource.data.userId == request.auth.uid) ||
        request.resource.data.userId == 'guest'
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Settings Collection (Public read, Admin write)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cities Collection (Public read, Admin write)
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Branches Collection (Public read, Admin write)
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Delivery Zones Collection (Public read, Admin write)
    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Referrals Collection
    match /referrals/{refId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.referrerUserId == request.auth.uid || resource.data.referredUserId == request.auth.uid));
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
